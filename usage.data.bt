//------------------------------------------------
//--- 010 Editor v11.0.1 Binary Template
//
//      File: usage.data.bt
//   Authors: Greatness7
//   Version:
//   Purpose: Parse "usage.data" files (generated by MGE XE).
//  Category: Games
// File Mask: usage.data
//  ID Bytes:
//   History: https://github.com/Greatness7/binary_templates
//------------------------------------------------

LittleEndian();


/* -- Basic Types -- */

typedef enum <byte> {
    DATA_SOURCE_JOURNAL = 1,
    DATA_SOURCE_GLOBAL = 2,
    DATA_SOURCE_UNIQUE_OBJECT = 3,
} DataSource;

typedef struct {
    uint id;
    ushort visIndex;
    float location[3];
    float rotation[3];
    float scale;
} Reference;

typedef struct {
    uint numReferences;
    if (numReferences) {
        char cellName[64];
        Reference references[numReferences];
    }
} Interior;

typedef struct {
    DataSource dataSource;
    char id[64];
    byte numEnabledRanges;
    struct { int min; int max; } enabledRanges[numEnabledRanges];
    int64 padding[8 - numEnabledRanges];
} DynamicVisGroup;


/* -- Begin Parsing -- */

uint numNifs;

uint numDynamicVisGroups;
DynamicVisGroup dynamicVisGroups[numDynamicVisGroups] <optimize=true>;

uint numExteriorReferences;
Reference exteriorReferences[numExteriorReferences];

do {
    Interior interior;
} while (interior.numReferences);

float minStaticSize;

Assert(FEof());
