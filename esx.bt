		case "NAME": DIAL_NAME(sr); break;
		case "DATA": DIAL_DATA(sr); break;
		case "XIDX": DIAL_XIDX(sr); break;
		case "DELE": DIAL_DELE(sr); break;
		default:
			byte undefined[sr.size];
			sr.displayName = sr.tag + " (?)";
	}
}


