		case "CLDT": CLAS_CLDT(sr); break;
		case "DESC": CLAS_DESC(sr); break;
		case "DELE": CLAS_DELE(sr); break;
		default:
			byte undefined[sr.size];
			sr.displayName = sr.tag + " (?)";
	}
}


