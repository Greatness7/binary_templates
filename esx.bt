	char id[sr.size];
	/* -- Display -- */
	sr.displayName = "NAME (Id)";
	sr.displayValue = id;
}

void CELL_DATA(SubRecord &sr) {
	if (sr.size == 12) {  // Cell Data
		uint flags;
		int gridX;
		int gridY;
		SPrintf(sr.displayValue, "(%d, %d)", gridX, gridY);
	} else {  // Reference Data
		float xPosition;
		float yPosition;
		float zPosition;
		float xRotation;
		float yRotation;
		float zRotation;
	}
	/* -- Display -- */
	sr.displayName = "DATA (Cell Data)";
	SPrintf(sr.displayValue, "Size: %d", sr.size);
}

