void NPC__NPDT(SubRecord &sr) {
	if (sr.size == 12) { // AutoCalc Enabled
		short level;
		byte disposition;
		byte reputation;
		byte rank;
		ubyte padding[3];
		uint gold;
	} else {  // AutoCalc Disabled
		short level;
		byte attributes[8];
		byte skills[27];
		byte padding;
		short health;
		short magicka;
		short fatigue;
		byte disposition;
		byte reputation;
		byte rank;
		byte padding;
		uint gold;
	}
	/* -- Display -- */
	sr.displayName = "NPDT (NPC Data)";
	SPrintf(sr.displayValue, "AutoCalc: %s", (sr.size == 12) ? "Yes" : "No");
}

