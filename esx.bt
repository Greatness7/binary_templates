/* -- SPLM (Spell List - Save File) -- */

void SPLM_MLPS(SubRecord &sr) {
	char id[sr.size];
	/* -- Display -- */
	sr.displayName = "MLPS (Header)";
	sr.displayValue = id;
}

void SPLM_EMAN(SubRecord &sr) {
	uint serialNumber;
	/* -- Display -- */
	sr.displayName = "EMAN (Magic Source Instance)";
	SPrintf(sr.displayValue, "Serial: %u", serialNumber);
}

void SPLM_0MAN(SubRecord &sr) {
	byte value;
	/* -- Display -- */
	sr.displayName = "NAM0 (Always Zero)";
	SPrintf(sr.displayValue, "%d", value);
}

void SPLM_FMAN(SubRecord &sr) {
	char spellName[sr.size];
	/* -- Display -- */
	sr.displayName = "FNAM (Spell Name)";
	sr.displayValue = spellName;
}

void SPLM_MANC(SubRecord &sr) {
	char actorId[sr.size];
	/* -- Display -- */
	sr.displayName = "CNAM (Effect Actor)";
	sr.displayValue = actorId;
}

void SPLM_MANI(SubRecord &sr) {
	char itemId[sr.size];
	/* -- Display -- */
	sr.displayName = "INAM (Effect Item)";
	sr.displayValue = itemId;
}

void SPLM_MANT(SubRecord &sr) {
	char targetRefId[sr.size];
	/* -- Display -- */
	sr.displayName = "TNAM (Target Reference)";
	sr.displayValue = targetRefId;
}

void SPLM_TDPS(SubRecord &sr) {
	int sourceComboType;
	char magicId[32];
	float overrideCastChance;
	float corprusHoursSinceLastWorsen;
	float timestampCastBegin;
	int spellState;
	char casterRefId[32];
	char castingItemId1[32];
	float itemCharge;
	char castingItemConditionIndex;
	byte padding1[3];
	char castingItemId2[32];
	char bypassResistances;
	byte padding2[3];
	/* -- Display -- */
	sr.displayName = "SPDT (Spell Data)";
	SPrintf(sr.displayValue, "Caster: %s, Magic: %s (%d), State: %d", casterRefId, magicId, sourceComboType, spellState);
}

void SPLM_TDPN(SubRecord &sr) {
	char targetId[32];
	char effectIndex;
	byte padding[3];
	float resistedPercent;
	unsigned int magnitude;
	float timeActive;
	float cumulativeMagnitude;
	int state;
	/* -- Display -- */
	sr.displayName = "NPDT (Serialized Magic Effect Instance)";
	SPrintf(sr.displayValue, "Target: %s, EffectIndex: %d, Magnitude: %d, State: %d", targetId, effectIndex, magnitude, state);
}

void SPLM_MANV(SubRecord &sr) {
	byte value;
	/* -- Display -- */
	sr.displayName = "VNAM (Byte Value)";
	SPrintf(sr.displayValue, "%d", value);
}

void SPLM_VNM0(SubRecord &sr) {
	byte value;
	/* -- Display -- */
	sr.displayName = "0NMV (Byte Value)";
	SPrintf(sr.displayValue, "%d", value);
}

void SPLM_NAME(SubRecord &sr) {
	uint serialNumber;
	/* -- Display -- */
	sr.displayName = "NAME (Magic Source Instance)";
	SPrintf(sr.displayValue, "Serial: %u", serialNumber);
}

void SPLM_XNAM(SubRecord &sr) {
	byte value;
	/* -- Display -- */
	sr.displayName = "XNAM (Always Zero)";
	SPrintf(sr.displayValue, "%d", value);
}

void SPLM(SubRecord &sr) {
	switch (sr.tag) {
		case "MLPS": SPLM_MLPS(sr); break;
		case "EMAN": SPLM_EMAN(sr); break;
		case "NAM0": SPLM_0MAN(sr); break;
		case "FNAM": SPLM_FMAN(sr); break;
		case "CNAM": SPLM_MANC(sr); break;
		case "INAM": SPLM_MANI(sr); break;
		case "TNAM": SPLM_MANT(sr); break;
		case "SPDT": SPLM_TDPS(sr); break;
		case "NPDT": SPLM_TDPN(sr); break;
		case "VNAM": SPLM_MANV(sr); break;
		case "0NMV": SPLM_VNM0(sr); break;
		case "NAME": SPLM_NAME(sr); break;
		case "XNAM": SPLM_XNAM(sr); break;
		default:
			byte undefined[sr.size];
			sr.displayName = sr.tag + " (?)";
	}
}


/* -- Begin Parsing -- */


while (!FEof()) {
	Record record;
}
